#!/usr/bin/env bash
# pi-delegate — one-shot delegation to an external subscription model via pi.
#
# Exists to remove the three failure modes of hand-composing the pi invocation:
#   --thinking low  — pi's saved default is `high`, which stalls for minutes
#   -e <gate>       — `-ne` (needed to skip ~15s of MCP discovery) also strips
#                     the pi-kit permission-gate extension; this re-adds it
#   hangs           — pi can hang indefinitely (observed on both session-resume
#                     and fresh one-shots; the calling harness still reports it
#                     "running"). Four such runs burned ~25h. Killed runs often
#                     leave salvageable edits — check the tree before relaunching.
# The provider is derived from the model name so the two can never drift apart.
#
# Hang detection is CPU-based, not duration-based. Every hung run observed sat in
# `Sl` — blocked on I/O, burning no CPU — while healthy runs legitimately take
# 7-45min, so elapsed time cannot distinguish them but CPU can. The run gets its
# own process group; the watchdog samples cumulative CPU across the WHOLE group
# (so a delegate waiting on its own pytest child still counts as alive) and kills
# the group once the entire tree has burned zero CPU for --stall minutes. Samples
# land in a heartbeat file so the caller can confirm liveness at any moment
# instead of waiting to find out.
#
# Playbook, briefs, review pipeline and scorecard: ~/.claude/skills/delegate/

set -euo pipefail

GATE="$HOME/.pi/agent/git/github.com/tkuminecz/pi-kit/extensions/permission-gate.ts"

model="grok-4.6"
thinking="low"
workdir="$PWD"
brief_file=""
session=""
json_mode=0
dry_run=0
prompt=""
timeout_mins=120
# default 6: 3 false kills of healthy glm/deepseek runs (slow zero-CPU starts) in one
# retro window; a true stall just gets caught 3min later, which is cheap by comparison
stall_mins=6
sample_secs=20
heartbeat=""
report=""

usage() {
	cat <<'EOF'
Usage: pi-delegate [options] "<task>"
       pi-delegate [options] -f <brief-file>

Options:
  -m, --model <id>      grok-4.6 (default) | grok-4.5 | glm-5.3 | glm-5.3-flash
                        | glm-5.2 | grok-build-0.1 | gpt-5.6-luna
                        | any OpenRouter id, e.g. deepseek/deepseek-v4-flash-0731
  -C, --dir <path>      working dir for the delegate (default: cwd). Use the repo
                        root so pi auto-loads its AGENTS.md / CLAUDE.md.
  -f, --file <path>     brief file; sends "Read and execute the brief at <abs>"
  -t, --thinking <lvl>  low (default) | medium | high | xhigh   [high stalls short one-shot tasks — avoid]
  -s, --session <uuid>  reuse/create a pi session for follow-up turns
                        [prefer a fresh one-shot for fix loops — resume hangs]
  -W, --stall <mins>    kill the run once its whole process tree has burned ZERO
                        cpu for this long, default 6; 0 disables. Exits 125.
                        This is the real hang detector — hung runs block on I/O
                        forever, healthy ones always burn cpu somewhere.
  -T, --timeout <mins>  backstop cap on total runtime, default 120; 0 disables.
                        Catches slow-but-alive runaways. Exits 124.
  -o, --report <p>      tee the delegate's stdout (its final report) to this file
                        (default $TMPDIR/pi-delegate-<pid>.report). The full
                        report survives whatever the caller pipes stdout into.
      --heartbeat <p>   where to write cpu/liveness samples
                        (default $TMPDIR/pi-delegate-<pid>.heartbeat)
      --json            stream structured events (--mode json) instead of text
  -n, --dry-run         print the pi command without running it
  -h, --help            show this

Exit codes: 0 ok; 1 empty report on success status; 2 usage/config error;
3 provider refused (402/429 / credit / rate-limit); 124 timeout cap; 125 stall.
Other codes pass through from pi.

Check the heartbeat file whenever you want — `tail -3` tells you in one second
whether a run is alive, so there is never a reason to sit and wonder.

Model -> provider is automatic (vendor/model -> openrouter, glm* -> zai, grok* -> xai, gpt* -> openai-codex).

Every brief should state a self-verification step ("run the tests and report
PASS/FAIL with output") and ask for a deviations list. Always review the diff
yourself afterward, then append a row to the delegate skill's LOG.md.
EOF
}

while [[ $# -gt 0 ]]; do
	case "$1" in
	-m | --model)
		model="${2:?--model needs a value}"
		shift 2
		;;
	-C | --dir)
		workdir="${2:?--dir needs a value}"
		shift 2
		;;
	-f | --file)
		brief_file="${2:?--file needs a value}"
		shift 2
		;;
	-t | --thinking)
		thinking="${2:?--thinking needs a value}"
		shift 2
		;;
	-s | --session)
		session="${2:?--session needs a value}"
		shift 2
		;;
	-T | --timeout)
		timeout_mins="${2:?--timeout needs a value}"
		shift 2
		;;
	-W | --stall)
		stall_mins="${2:?--stall needs a value}"
		shift 2
		;;
	-o | --report)
		report="${2:?--report needs a value}"
		shift 2
		;;
	--heartbeat)
		heartbeat="${2:?--heartbeat needs a value}"
		shift 2
		;;
	--json)
		json_mode=1
		shift
		;;
	-n | --dry-run)
		dry_run=1
		shift
		;;
	-h | --help)
		usage
		exit 0
		;;
	--)
		shift
		break
		;;
	-*)
		echo "pi-delegate: unknown option '$1' (try --help)" >&2
		exit 2
		;;
	*) break ;;
	esac
done

# A relative -o or --heartbeat means the caller's directory. The wrapper cds into -C
# before it opens either file, so pin them to absolute paths first.
if [[ -n "$report" && "$report" != /* ]]; then
	report="$PWD/$report"
fi
if [[ -n "$heartbeat" && "$heartbeat" != /* ]]; then
	heartbeat="$PWD/$heartbeat"
fi

case "$model" in
*/*) provider="openrouter" ;;
glm*) provider="zai" ;;
grok*) provider="xai" ;;
gpt-*) provider="openai-codex" ;;
*)
	echo "pi-delegate: cannot infer provider for model '$model' (expected vendor/model, glm*, grok* or gpt*)" >&2
	exit 2
	;;
esac

if [[ -n "$brief_file" ]]; then
	[[ -f "$brief_file" ]] || {
		echo "pi-delegate: brief file not found: $brief_file" >&2
		exit 2
	}
	abs_brief="$(cd "$(dirname "$brief_file")" && pwd)/$(basename "$brief_file")"
	prompt="Read and execute the brief at ${abs_brief}. Follow it exactly."
elif [[ $# -gt 0 ]]; then
	prompt="$*"
else
	echo "pi-delegate: need a task string or --file <brief> (try --help)" >&2
	exit 2
fi

[[ -d "$workdir" ]] || {
	echo "pi-delegate: no such directory: $workdir" >&2
	exit 2
}

args=(-p -ne --thinking "$thinking" --provider "$provider" --model "$model")

if [[ -f "$GATE" ]]; then
	args+=(-e "$GATE")
else
	# Non-fatal: the delegate still runs, just without the dangerous-bash gate.
	echo "pi-delegate: WARNING permission-gate extension missing at $GATE" >&2
	echo "pi-delegate:   run 'pi update --extensions' to restore it" >&2
fi

if [[ -n "$session" ]]; then
	args+=(--session-id "$session")
else
	args+=(--no-session)
fi

((json_mode)) && args+=(--mode json)

[[ "$timeout_mins" =~ ^[0-9]+$ ]] || {
	echo "pi-delegate: --timeout takes whole minutes (0 disables), got '$timeout_mins'" >&2
	exit 2
}
[[ "$stall_mins" =~ ^[0-9]+$ ]] || {
	echo "pi-delegate: --stall takes whole minutes (0 disables), got '$stall_mins'" >&2
	exit 2
}

if ((dry_run)); then
	printf 'cd %q && pi' "$workdir"
	printf ' %q' "${args[@]}" "$prompt"
	printf '\n'
	exit 0
fi

# The skill and wrappers reach each machine through chezmoi, and a source update that is
# never applied leaves this host briefing from stale rules. Warn only; never fails the run.
delegate_files=(
	"$HOME/.claude/skills/delegate/SKILL.md" "$HOME/.claude/skills/delegate/brief-common.md"
	"$HOME/bin/pi-delegate" "$HOME/bin/grok-delegate"
	"$HOME/bin/delegate-brief-check"
)
if command -v chezmoi >/dev/null 2>&1 &&
	! timeout 5 chezmoi verify "${delegate_files[@]}" >/dev/null 2>&1; then
	echo "delegate: the installed delegate skill or wrappers differ from the chezmoi source. Review with 'chezmoi diff ~/.claude/skills/delegate ~/bin', then 'chezmoi apply' those paths." >&2
fi

# The Write/Edit tools have turned a "\u00a0" escape into a literal NBSP, and that shipped
# straight into a delegate's test. Warn only; never fails the run.
if [[ -n "$brief_file" ]] && command -v delegate-brief-check >/dev/null 2>&1; then
	delegate-brief-check "$abs_brief" >&2 || true
fi

cd "$workdir"

# Every byte the delegate prints also lands in the report file, so a truncated or
# piped stdout on the caller's side (a `tail`, a full buffer) can never lose the
# report — that has cost two review rounds.
: "${report:=${TMPDIR:-/tmp}/pi-delegate-$$.report}"
: >"$report"
: >"$report.stderr"
echo "pi-delegate: report -> $report  (full stdout, survives caller-side truncation)" >&2

# Append a failure trailer to stdout and the report; detect provider refusal.
_pi_finish() {
	local status="$1"
	if [[ $status -eq 0 && -s "$report" ]]; then
		exit 0
	fi
	{
		echo
		echo "---- pi-delegate: pi exited ${status}; the report above may be partial or empty. Last stderr lines:"
		tail -n 20 "$report.stderr"
	} | tee -a "$report"
	if grep -qiE '(status|http|code|error)[^0-9]{0,15}(402|429)|payment required|balance exhausted|too many requests|rate[ _-]?limit|quota' "$report.stderr"; then
		local other
		case "$provider" in
		xai) other="pi-delegate -m glm-5.2" ;;
		zai) other="grok-delegate" ;;
		*) other="the other subscription" ;;
		esac
		echo "pi-delegate: PROVIDER REFUSED (${provider}) — out of credit or rate-limited. A 402 is an outage for the rest of the day: salvage the tree (git status, git diff, re-run the package's gates) and reroute to ${other}. A 429 may clear on one relaunch." >&2
		exit 3
	fi
	if [[ $status -eq 0 ]]; then
		exit 1
	fi
	exit "$status"
}

_pi_kill_trailer() {
	local kind="$1"
	{
		echo
		echo "---- pi-delegate: killed (${kind}); the report above may be partial or empty. Last stderr lines:"
		tail -n 20 "$report.stderr"
	} | tee -a "$report"
}

# No watchdog wanted: hand the process straight over (stdout still teed).
if ((timeout_mins == 0 && stall_mins == 0)); then
	exec > >(tee -a "$report")
	exec pi "${args[@]}" "$prompt" </dev/null
fi

: "${heartbeat:=${TMPDIR:-/tmp}/pi-delegate-$$.heartbeat}"

# Cumulative cpu seconds and process count for a whole process group.
tree_stat() {
	ps -eo pgid=,cputimes= 2>/dev/null |
		awk -v g="$1" '$1 == g { cpu += $2; n++ } END { print cpu + 0, n + 0 }'
}

# The tees get their own fds so their pids are known. A bare `wait` skips process
# substitutions, and judging the run before the report tee drained turned a
# successful run into "empty report, exit 1". The drain is bounded because a
# grandchild still holding the pipe must not hang the wrapper.
exec {out_fd}> >(tee -a "$report")
out_tee=$!
exec {err_fd}> >(tee -a "$report.stderr" >&2)
err_tee=$!
drain_tees() {
	exec {out_fd}>&- {err_fd}>&-
	local p
	for p in "$out_tee" "$err_tee"; do
		for _ in $(seq 50); do
			kill -0 "$p" 2>/dev/null || break
			sleep 0.1
		done
	done
}

# Own process group, so one kill reaches the delegate and every child it spawned.
# stdin from /dev/null: a background process group reading the tty gets SIGTTIN.
set -m
pi "${args[@]}" "$prompt" </dev/null >&"$out_fd" 2>&"$err_fd" {out_fd}>&- {err_fd}>&- &
pid=$!
set +m
pgid=$pid

stall_limit=0
((stall_mins > 0)) && stall_limit=$(((stall_mins * 60 + sample_secs - 1) / sample_secs))

{
	echo "# pi-delegate $model @ $provider  pid=$pid pgid=$pgid"
	echo "# workdir=$workdir"
	echo "# sampling every ${sample_secs}s; stall kill after ${stall_mins}m zero-cpu; cap ${timeout_mins}m"
} >"$heartbeat"

echo "pi-delegate: heartbeat -> $heartbeat  (tail it any time to confirm liveness)" >&2

start=$SECONDS
last_cpu=-1
idle_streak=0
verdict=""
tick=0

while kill -0 "$pid" 2>/dev/null; do
	sleep 1
	((++tick % sample_secs == 0)) || continue
	kill -0 "$pid" 2>/dev/null || break

	read -r cpu procs < <(tree_stat "$pgid")
	elapsed=$((SECONDS - start))
	if ((last_cpu < 0)); then dcpu=$cpu; else dcpu=$((cpu - last_cpu)); fi
	last_cpu=$cpu

	if ((dcpu > 0)); then idle_streak=0; else ((++idle_streak)); fi

	printf '%s elapsed=%ds tree_cpu=%ds dcpu=%ds procs=%d idle=%d/%d\n' \
		"$(date -Is)" "$elapsed" "$cpu" "$dcpu" "$procs" "$idle_streak" "$stall_limit" \
		>>"$heartbeat"

	if ((stall_limit > 0 && idle_streak >= stall_limit)); then
		verdict="stall"
		break
	fi
	if ((timeout_mins > 0 && elapsed >= timeout_mins * 60)); then
		verdict="cap"
		break
	fi
done

if [[ -n "$verdict" ]]; then
	kill -TERM -"$pgid" 2>/dev/null || kill -TERM "$pid" 2>/dev/null || true
	for _ in $(seq 15); do
		kill -0 "$pid" 2>/dev/null || break
		sleep 1
	done
	kill -KILL -"$pgid" 2>/dev/null || true
	set +e
	wait "$pid" 2>/dev/null
	set -e
	drain_tees

	if [[ "$verdict" == "stall" ]]; then
		echo "KILLED: stalled — zero cpu across the whole process tree for ${stall_mins}m" >>"$heartbeat"
		_pi_kill_trailer "stalled"
		echo "pi-delegate: HUNG and killed — the entire process tree burned zero cpu for ${stall_mins}m." >&2
		echo "pi-delegate:   Partial work may have landed. Salvage first: git status and git diff the tree," >&2
		echo "pi-delegate:   check the code under any comment that claims behaviour, run the package's own" >&2
		echo "pi-delegate:   gates, then relaunch (a FRESH one-shot, never a session resume) only for what is missing." >&2
		tail -3 "$heartbeat" >&2
		exit 125
	fi

	echo "KILLED: hit the ${timeout_mins}m cap while still burning cpu" >>"$heartbeat"
	_pi_kill_trailer "hit the ${timeout_mins}m cap"
	echo "pi-delegate: hit the ${timeout_mins}m cap and was killed. It was still burning cpu," >&2
	echo "pi-delegate:   so this is a slow/runaway run, not the usual hang — check for partial" >&2
	echo "pi-delegate:   work before relaunching, and raise -T if the package is genuinely big." >&2
	tail -3 "$heartbeat" >&2
	exit 124
fi

set +e
wait "$pid"
status=$?
set -e
drain_tees

# last_cpu is the final sample; the tree is already gone by now, so re-reading it
# would always report 0. -1 means the run finished before the first sample.
if ((last_cpu < 0)); then last_seen="unsampled"; else last_seen="${last_cpu}s"; fi
printf 'EXIT %d after %ds (last sampled tree_cpu=%s)\n' \
	"$status" "$((SECONDS - start))" "$last_seen" >>"$heartbeat"

_pi_finish "$status"
