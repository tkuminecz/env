#!/usr/bin/env bash
# delegate-retro-due — is the delegation retro due? Reads the scorecard's retro-state and
# counts the rows logged since (the trigger rules live in the delegate SKILL.md "Retro").
#
# `base=<N>` in retro-state is the row count the retro left behind; rows beyond it are new.
# Dates alone can't separate same-day rows: the 09-22 retro closed mid-day and the 15 rows
# logged after it that day never counted. Without `base` it falls back to rows dated after
# `last`.
#
# Exit 0 and print one line when due; exit 1 silently when not; exit 2 if the log is
# unreadable. The wrappers call it at launch and ignore its status, so it must never be
# the reason a delegation fails.

log="${DELEGATE_LOG:-$HOME/.claude/skills/delegate/LOG.md}"
[[ -r "$log" ]] || exit 2

last="$(grep -oE 'retro-state: last=[0-9]{4}-[0-9]{2}-[0-9]{2}' "$log" | head -1 | cut -d= -f2)"
[[ -n "$last" ]] || exit 2

today="${DELEGATE_TODAY:-$(date +%F)}"
base="$(grep -oE 'retro-state: last=[0-9-]+ base=[0-9]+' "$log" | head -1 | cut -d= -f3)"
if [[ -n "$base" ]]; then
	total="$(grep -cE '^\| [0-9]{4}-[0-9]{2}-[0-9]{2}' "$log")"
	rows=$((total > base ? total - base : 0))
else
	rows="$(awk -v last="$last" '/^\| [0-9]{4}-[0-9]{2}-[0-9]{2} \|/ { if ($2 > last) n++ } END { print n + 0 }' "$log")"
fi
days=$((($(date -d "$today" +%s) - $(date -d "$last" +%s)) / 86400))

# 1-day cooldown gates both triggers; then 5 rows, or 14 days with at least one row.
if ((days >= 1)) && { ((rows >= 5)) || { ((days >= 14)) && ((rows >= 1)); }; }; then
	echo "delegate: retro due — $rows rows logged since $last ($days days). Hand it off per the delegate skill's Retro section."
	exit 0
fi
exit 1
