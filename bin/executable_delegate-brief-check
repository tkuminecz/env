#!/usr/bin/env python3
"""delegate-brief-check — flag invisible Unicode in a delegation brief before it ships.

Catches non-ASCII spaces (NBSP and the rest of Zs), zero-width characters and BOMs. The
Write/Edit tools have turned an intended "\\u00a0" escape into a literal NBSP; that brief
shipped the invisible character and the delegate's test copied it. Visible non-ASCII (em
dashes, arrows) is left alone.

A missing-path check was tried and dropped: package-relative paths, URL routes and files the
package is meant to create made it flag most real briefs.

Usage: delegate-brief-check <brief-file>
Prints warnings to stdout and exits 1 when there are any, 0 when the brief is clean, 2 on bad
usage. The wrappers call it at launch and ignore the status, so it can never be what fails a
delegation.
"""

import argparse
import sys
import unicodedata
from pathlib import Path

INVISIBLE = {0x200B, 0x200C, 0x200D, 0x2060, 0xFEFF}


def invisible_chars(lines):
    for lineno, line in enumerate(lines, 1):
        for col, ch in enumerate(line, 1):
            cp = ord(ch)
            if cp in INVISIBLE or (cp > 0x7F and unicodedata.category(ch) == "Zs"):
                name = unicodedata.name(ch, "UNKNOWN")
                yield f"line {lineno} col {col}: invisible U+{cp:04X} {name}"


def main():
    parser = argparse.ArgumentParser(add_help=True)
    parser.add_argument("brief")
    args = parser.parse_args()
    try:
        lines = Path(args.brief).read_text(encoding="utf-8").splitlines()
    except (OSError, UnicodeDecodeError) as exc:
        print(f"delegate-brief-check: cannot read {args.brief}: {exc}", file=sys.stderr)
        return 2

    warnings = list(invisible_chars(lines))
    for w in warnings:
        print(f"delegate-brief-check: {w}")
    return 1 if warnings else 0


if __name__ == "__main__":
    sys.exit(main())
