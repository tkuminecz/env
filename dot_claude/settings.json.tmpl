{{- /* Per-host differences live here as hostname branches, so `chezmoi
       apply` never clobbers them. The defaults are the Mac's settings. */ -}}
{{- /* Not .chezmoi.hostname: that resolves through /etc/hosts, where the
       dev stack on jb-dev aliases the machine name onto api.jb-dev. */ -}}
{{- $h := output "hostname" | trim | splitList "." | first -}}
{
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "Read(*)",
      "Search(*)",
      "Edit(*)",
      "Write(*)",
      "Bash(ls *)",
      "Bash(uv *)",
      "Bash(ruff *)",
      "Bash(mise *)",
      "Bash(git *)",
      "Bash(gh pr *)",
      "Bash(curl *)",
      "Bash(find *)"
    ],
    "deny": [],
    "ask": [
{{- /* jb-dev2 has no PreToolUse hook (below), so these globs are its only
       guard. */}}
{{- if eq $h "jb-dev2" }}
      "Bash(git push * --force*)",
      "Bash(rm -rf *)",
      "Bash(rm -r *)"
{{- end }}
    ]
  },
{{- if or (eq $h "tim-dev") (eq $h "jb-dev2") }}
  "model": "opus[1m]",
{{- else }}
  "model": "opus",
{{- end }}
  "enabledMcpjsonServers": [
    "superset-test",
    "superset-staging",
    "superset-prod",
    "langfuse-test",
    "langfuse-staging",
    "langfuse-prod",
    "sentry",
    "linear"
  ],
  "hooks": {
{{- /* jb-dev2 runs the unattended review factory. A "warn" rule there
       resolves to permissionDecision "ask", which prompts even under
       --permission-mode bypassPermissions — so instead of warning anyone it
       stalls a review agent mid-run until someone notices. No PreToolUse
       hook on that host; every other machine keeps it. */}}
{{- if ne $h "jb-dev2" }}
    "PreToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 {{ .chezmoi.homeDir }}/.claude/hooks/pre_tool_call.py"
          }
        ]
      }
    ],
{{- end }}
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash '{{ .chezmoi.homeDir }}/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      }
{{- /* queohoh is only installed on tim-dev. */}}
{{- if eq $h "tim-dev" }},
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "{{ .chezmoi.homeDir }}/.local/bin/queohoh heartbeat",
            "timeout": 5
          }
        ]
      }
{{- end }}
    ]
{{- if eq $h "tim-dev" }},
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{{ .chezmoi.homeDir }}/.local/bin/queohoh heartbeat",
            "timeout": 5
          }
        ]
      }
    ]
{{- end }}
  },
  "statusLine": {
    "type": "command",
    "command": "bash {{ .chezmoi.homeDir }}/.claude/statusline.sh"
  },
  "enabledPlugins": {
    "claude-hud@claude-hud": true,
    "coderabbit@claude-plugins-official": true,
    "superpowers@superpowers-marketplace": false
{{- if eq $h "tim-dev" }},
    "rust-analyzer-lsp@claude-plugins-official": true
{{- end }}
  },
  "extraKnownMarketplaces": {
    "claude-hud": {
      "source": {
        "source": "github",
        "repo": "jarrodwatts/claude-hud"
      }
    }
  },
{{- if or (eq $h "jb-dev") (eq $h "jb-dev2") }}
  "effortLevel": "medium",
{{- else }}
  "effortLevel": "high",
{{- end }}
  "modelSettings": {
{{- if eq $h "jb-dev" }}
    "claude-fable-5": {
      "effortLevel": "high"
    },
    "claude-fable-5-1": {
      "effortLevel": "high"
    },
    "claude-opus-4-6": {
      "effortLevel": "high"
    },
    "claude-opus-4-8": {
      "effortLevel": "xhigh"
    },
    "claude-opus-5": {
      "effortLevel": "xhigh"
    },
    "claude-opus-5-5": {
      "effortLevel": "high"
    }
{{- else if eq $h "jb-dev2" }}
    "claude-opus-5-5": {
      "effortLevel": "medium"
    }
{{- else }}
    "claude-opus-5-5": {
      "effortLevel": "high"
    }
{{- end }}
  },
{{- if ne $h "jb-dev2" }}
  "autoMemoryEnabled": false,
{{- end }}
{{- if eq $h "tim-dev" }}
  "feedbackDrafts": "off",
  "promptSuggestionEnabled": false,
{{- end }}
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "remoteControlAtStartup": false,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "env": {
    "CLAUDE_CODE_ENABLE_TELEMETRY": "1",
    "OTEL_METRICS_EXPORTER": "otlp",
    "OTEL_LOGS_EXPORTER": "otlp",
    "OTEL_EXPORTER_OTLP_PROTOCOL": "http/json",
    {{- /* cutd runs on tim-dev; point at it over the network from every
    other machine, and at localhost on tim-dev itself. */}}
    {{- if eq $h "tim-dev" }}
    "OTEL_EXPORTER_OTLP_ENDPOINT": "http://localhost:8420"
    {{- else }}
    "OTEL_EXPORTER_OTLP_ENDPOINT": "http://tim-dev:8420"
    {{- end }}
{{- if or (eq $h "jb-dev") (eq $h "jb-dev2") }},
    "OTEL_RESOURCE_ATTRIBUTES": "host.name={{ $h }}"
{{- end }}
{{- if eq $h "jb-dev2" }},
    "DISABLE_AUTOUPDATER": "1"
{{- end }}
  }
}
