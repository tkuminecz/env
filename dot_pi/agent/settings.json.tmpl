{
  "theme": "dark",

  {{- /*
    Note: "lastChangelogVersion" is intentionally NOT here. pi stamps
    it into the file after updates; chezmoi strips it on the next apply,
    so the template only defines keys you own. Consequence: the changelog
    stamp never survives, so pi re-shows the changelog on every update.
  */}}

  {{- /* Per-machine provider/model. Edit the hostnames to match your machines. */}}
  {{- if eq .chezmoi.hostname "workbox" }}
  "defaultProvider": "openrouter",
  "defaultModel": "deepseek/deepseek-v4-flash-0731",
  {{- else if eq .chezmoi.hostname "tim-macbook-pro-wifi" }}
  "defaultProvider": "pi-claude-cli",
  "defaultModel": "claude-fable-5",
  {{- else }}
  "defaultProvider": "anthropic",
  "defaultModel": "claude-sonnet-4-5",
  {{- end }}

  "defaultThinkingLevel": "high",

  {{- /* Packages are shared everywhere; pi auto-installs them per machine. */}}
  "packages": [
    "git:git@github.com:tkuminecz/pi-kit",
    "npm:pi-blackhole",
    "npm:pi-web-access",
    "npm:@99percentpeople/pi-thinking-fold",
    "npm:pi-execution-time",
    "npm:@vanillagreen/pi-tool-renderer",
    "npm:@baretread/pi-forge",
    "npm:pi-cc-header",
    "npm:pi-claude-cli",
    "npm:@ogulcancelik/pi-herdr"
  ],

  "quietStartup": true,
  "clearOnStart": true
}